[Unit]
Description=NOC Agent Weekly Eval Run Schedule (Mon 08:30 CT)
After=network-online.target
Wants=network-online.target

[Timer]
# Monday 08:30 in the system local timezone (assumes box TZ = America/Chicago).
OnCalendar=Mon *-*-* 08:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
