{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Permission profile for UNATTENDED OpenCode agents (the ticket batch runs). server/index.js passes it with OPENCODE_CONFIG. It is merged with the project opencode.json, needs OpenCode 2.x (the 'permissions' array; 1.x uses a different shape and ignores or rejects this), and rules are evaluated in order with the LAST match winning. Edits are refused everywhere except /tmp and logs/ (result files, comment HTML), secrets cannot be read, and git, package and service commands that change the checkout are refused. The shell cannot be fully fenced (python3 -c, tee and similar still write), so deploy/noc-agent.protect-tree.conf.template makes the checkout read-only for the service at the operating-system level, and scripts/tree_guard.py reports any drift.",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
    { "action": "edit", "resource": "logs/*", "effect": "allow" },

    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": ".env.*", "effect": "deny" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },
    { "action": "read", "resource": ".secrets/*", "effect": "deny" },
    { "action": "read", "resource": "mcp-server/config/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "mcp-server/config/credentials.enc*", "effect": "deny" },
    { "action": "read", "resource": "backups/*", "effect": "deny" },
    { "action": "read", "resource": "gui-backups/*", "effect": "deny" },
    { "action": "read", "resource": "*/.config/nocagent/*", "effect": "deny" },
    { "action": "read", "resource": "*/nocagent-backups/*", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "cat .env*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env", "effect": "deny" },
    { "action": "shell", "resource": "cat *credentials.json*", "effect": "deny" },
    { "action": "shell", "resource": "cat *credentials.enc*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.secrets/*", "effect": "deny" },
    { "action": "shell", "resource": "head .env*", "effect": "deny" },
    { "action": "shell", "resource": "tail .env*", "effect": "deny" },
    { "action": "shell", "resource": "less .env*", "effect": "deny" },
    { "action": "shell", "resource": "more .env*", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "export -p*", "effect": "deny" },
    { "action": "shell", "resource": "declare -p*", "effect": "deny" },
    { "action": "shell", "resource": "sshpass -p*", "effect": "deny" },

    { "action": "shell", "resource": "git commit*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout*", "effect": "deny" },
    { "action": "shell", "resource": "git restore*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "git stash*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git merge*", "effect": "deny" },
    { "action": "shell", "resource": "git apply*", "effect": "deny" },
    { "action": "shell", "resource": "git config*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree*", "effect": "deny" },

    { "action": "shell", "resource": "npm install*", "effect": "deny" },
    { "action": "shell", "resource": "npm i *", "effect": "deny" },
    { "action": "shell", "resource": "npm ci*", "effect": "deny" },
    { "action": "shell", "resource": "npm update*", "effect": "deny" },
    { "action": "shell", "resource": "npm audit fix*", "effect": "deny" },
    { "action": "shell", "resource": "pip install*", "effect": "deny" },
    { "action": "shell", "resource": "pip3 install*", "effect": "deny" },
    { "action": "shell", "resource": "python3 -m pip*", "effect": "deny" },

    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "systemctl*", "effect": "deny" },
    { "action": "shell", "resource": "service *", "effect": "deny" },
    { "action": "shell", "resource": "crontab*", "effect": "deny" },
    { "action": "shell", "resource": "sed -i*", "effect": "deny" },
    { "action": "shell", "resource": "perl -pi*", "effect": "deny" },
    { "action": "shell", "resource": "chmod *", "effect": "deny" },
    { "action": "shell", "resource": "chown *", "effect": "deny" },

    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "comment-formatting", "effect": "allow" },
    { "action": "skill", "resource": "correlated-auto-return", "effect": "allow" },
    { "action": "skill", "resource": "correlated-issues", "effect": "allow" },
    { "action": "skill", "resource": "duplicate-detection", "effect": "allow" },
    { "action": "skill", "resource": "google-chat", "effect": "allow" },
    { "action": "skill", "resource": "ihn-auto-return", "effect": "allow" },
    { "action": "skill", "resource": "librenms", "effect": "allow" },
    { "action": "skill", "resource": "mymate", "effect": "allow" },
    { "action": "skill", "resource": "path-analyzer", "effect": "allow" },
    { "action": "skill", "resource": "peak-scheduler", "effect": "allow" },
    { "action": "skill", "resource": "sonar-api", "effect": "allow" },
    { "action": "skill", "resource": "ticket-context", "effect": "allow" },
    { "action": "skill", "resource": "tracker-sheet", "effect": "allow" },
    { "action": "skill", "resource": "wave-gui", "effect": "allow" },
    { "action": "skill", "resource": "wireless-health", "effect": "allow" }
  ],
  "_comment_skills": "Batch runs see only the skills the AGENTS.md ticket workflow uses (and the skills those name). OpenCode drops a denied skill from the catalog it sends with every request, so the operator's global skills (~/.agents/skills, OpenCode's built-in ones) and the operator-led project skills (device programming, temporary connections, onboarding) stay out of unattended runs. server/index.test.mjs keeps this list in step with AGENTS.md.",
  "_comment_agents": "The session-title agent is off for batch runs: a title only labels the session list, which nobody reads for unattended runs, and with no title model configured OpenCode 2.x picks a paid small model on the session's provider (gpt-6-luna on opencode and opencode-go), one extra request per run.",
  "agents": {
    "title": { "disabled": true }
  }
}
