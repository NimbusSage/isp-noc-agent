# =====================================================================
# NocAgent environment template
#
# Copy to `.env` (or let scripts/env_set.py create it) and fill in. Never
# commit the real `.env`. Rebuilt from what the code actually reads;
# `python3 scripts/docs_check.py` fails when a variable is read but missing
# here.
#
# How this file works
#   * Every line is safe to `source`: values are quoted or commented out.
#   * Uncommented lines are the ones you normally fill in (blank = unset).
#     Commented lines (# NAME="default") are optional; the shown value is
#     the built-in default, so uncomment only to change it.
#   * The line above each variable says what it is, its default, and
#     REQUIRED or OPTIONAL. Tier headers show how far you want to go:
#       Tier 0  demo only, nothing needed
#       Tier 1  device access (MCP server, LibreNMS, MyMate, gated writes)
#       Tier 2  Sonar + notifications + the ticket pipeline server
#       Tier 3  Google Calendar / Sheets integrations
#   * Put secrets in with `python3 scripts/env_set.py KEY` (hidden prompt)
#     or `env_set.py --generate KEY`; never paste them into an agent chat.
#     In Claude Code run it as `! python3 scripts/env_set.py KEY`.
#     `env_set.py --list-missing --tier 2` lists required names still unset.
# =====================================================================

# --- Tier 0: demo and general paths (nothing here is needed to try the demo) ---
# `python3 scripts/demo.py` runs the whole pipeline against a mock Sonar with no .env.

# Alternate path of this env file for the scripts. Default: <repo>/.env. OPTIONAL.
# NOC_DOTENV=""
# Alternate path of the env file for the MCP server. Default: <repo>/.env. OPTIONAL.
# NOC_MCP_DOTENV=""
# Set to 1 to stop the pipeline server loading .env itself (systemd EnvironmentFile supplies it). Default: unset. OPTIONAL.
# NOC_SKIP_DOTENV=""
# Directory holding the org's site-pack (profile.json, devices.md, ...). Default: <repo>/site-pack. OPTIONAL.
# NOC_SITE_PACK_DIR=""
# Alternate path of the org profile JSON. Default: <site-pack>/profile.json. OPTIONAL.
# NOC_PROFILE_FILE=""
# Your handle in the team roster (site-pack/team.json). On your own machine `python3 scripts/team.py me <handle>`
# saves it instead; the web launcher and batch runs set it themselves. OPTIONAL.
# NOC_OPERATOR=""
# Alternate path of the team roster. Default: <site-pack>/team.json. OPTIONAL.
# NOC_TEAM_FILE=""
# Alternate path of your per-user settings (handle, pack options). Default: ~/.config/nocagent/user.json. OPTIONAL.
# NOC_USER_CONFIG=""
# Checkout that scripts/tree_guard.py inspects for uncommitted drift. Default: the repository the script is in. OPTIONAL.
# NOC_TREE_GUARD_REPO=""
# Alternate git directory of the shared site pack. Default: <site-pack>/.pack.git. OPTIONAL.
# NOC_PACK_GIT_DIR=""
# Deploy key for the private pack repository (made by `python3 scripts/pack.py deploy-key`).
# Default: ~/.config/nocagent/pack_deploy_key, used only when that file exists. OPTIONAL.
# NOC_PACK_SSH_KEY=""
# Demo stub bounce behaviour (see scripts/demo_agent_stub.py). Default: stub decides. OPTIONAL.
# DEMO_BOUNCE_MODE=""
# Directory of demo fixtures. Default: scripts/demo/fixtures. OPTIONAL.
# DEMO_FIXTURES_DIR=""

# --- Tier 1: device access (MCP server and network integrations) ---

# Passphrase that decrypts mcp-server/config/credentials.enc. Generate: env_set.py --generate NOC_MCP_PASSPHRASE. REQUIRED.
NOC_MCP_PASSPHRASE=""
# Router password for the path-analyzer bandwidth tests (btest). The agent reads it from the environment; it is never read from a file. Set it with env_set.py BTEST_PASSWORD. REQUIRED for the btest steps of path analysis (read-only analysis works without it).
BTEST_PASSWORD=""
# Alternate path of the encrypted credential store. Default: mcp-server/config/credentials.enc. OPTIONAL.
# NOC_CREDENTIALS_ENC=""
# Alternate path of the MCP server config file. Default: mcp-server/config. OPTIONAL.
# NOC_MCP_CONFIG=""
# Plain-env device credentials instead of the encrypted store: NOC_<TYPE>_USER, NOC_<TYPE>_PASSWORD
# (NOC_<TYPE>_API_TOKEN for token types such as ubnt-uisp), TYPE = device type upper-cased, '-' -> '_'. OPTIONAL.
# NOC_MIKROTIK_SSH_USER="admin"
# NOC_MIKROTIK_SSH_PASSWORD=""
# NOC_UBNT_UISP_API_TOKEN=""
# NOC_UBNT_WAVE_USER=""
# NOC_UBNT_WAVE_PASSWORD=""

# Wave rain-fade readiness (path-analyzer Wave link mode). OPTIONAL; the values shown are the defaults.
# Rain rate in mm/h below which a link is tiered RED / AMBER (a link that dies at a lower rain rate is worse).
# RF_TIER_RED_MM_H="25"
# RF_TIER_AMBER_MM_H="50"

# Wave gen3 web UI creds (wave_gui.mjs HTTP API); falls back to the ubnt-wave credstore pool when unset. OPTIONAL.
# WAVE_GUI_USER=""
# WAVE_GUI_PASS=""

# Hosts or CIDRs the read tools may aim credentials at, comma separated. Default: private and link-local space only. OPTIONAL.
# NOC_READ_ALLOWED_HOSTS=""
# Set to 1 to allow allowlist CIDRs broader than /8. Default: off. OPTIONAL.
# ALLOW_BROAD_CIDR=""
# SSH host key policy of the MCP server: off | warn | tofu | strict. Default: warn (records keys, never blocks). OPTIONAL.
# NOC_SSH_HOSTKEY_MODE="warn"
# Where the MCP server keeps recorded host keys. Default: mcp-server/config/known_hosts.json. OPTIONAL.
# NOC_KNOWN_HOSTS_FILE=""
# Host key policy of the ssh-based scripts: accept-new | yes | no. Default: accept-new. OPTIONAL.
# SSH_HOSTKEY_CHECKING="accept-new"
# known_hosts file of the ssh-based scripts. Default: ~/.cache/nocagent/known_hosts. OPTIONAL.
# SSH_KNOWN_HOSTS_FILE=""
# SSH connect timeout in seconds for the shell scripts. Default: 8. OPTIONAL.
# NOC_SSH_CONNECT_TIMEOUT="8"

# LibreNMS base URL (corroboration only, not site truth). Default: none. OPTIONAL.
LIBRENMS_URL=""
# LibreNMS API token. Set with env_set.py. OPTIONAL.
LIBRENMS_TOKEN=""
# Dedicated non-admin LibreNMS web account named by the chart renderer fallback (no password is read). Default: none. OPTIONAL.
# LIBRENMS_WEB_USER=""
# Name of the header your auth proxy sets with the viewer's email on chart URLs. Default: X-Forwarded-Email. OPTIONAL.
# CHART_EMAIL_HEADER="X-Forwarded-Email"

# UISP controller base URL (https://host, no path). Default: none; register it with scripts/resources.py. OPTIONAL.
# UISP_BASE_URL=""

# MyMate base URL. Default: none. OPTIONAL.
# MYMATE_URL=""
# MyMate read-only login for the nocagent session. Default: none. OPTIONAL.
# MYMATE_USER=""
# Password for MYMATE_USER. Set with env_set.py. OPTIONAL.
# MYMATE_PASS=""
# Oxidized config backup server base URL. Default: none. OPTIONAL.
# OXIDIZED_BASE_URL=""
# Wave radio GUI default target URL for scripts/wave_gui.mjs. Default: pass --url instead. OPTIONAL.
# WAVE_DEVICE_URL=""
# Wave radio GUI login for scripts/wave_gui.mjs (never printed). Default: none. OPTIONAL.
# WAVE_GUI_USER=""
# Password for WAVE_GUI_USER. Set with env_set.py. OPTIONAL.
# WAVE_GUI_PASS=""
# File the Wave GUI token is written to, created 0600. Default: none. OPTIONAL.
# WAVE_TOKEN_OUT=""
# Chrome binary used by wave_gui.mjs. Default: /usr/bin/google-chrome. OPTIONAL.
# CHROME_PATH=""
# 1 forces Chrome's --no-sandbox, 0 forbids it. Default: only when running as root. OPTIONAL.
# CHROME_NO_SANDBOX=""
# Regex of customer-side subnets that fleet_bind_sweep.mjs skips. Default: none. OPTIONAL.
# FLEET_CUSTOMER_SUBNETS=""
# Regex of customer-style device names that fleet_bind_sweep.mjs skips. Default: none. OPTIONAL.
# FLEET_CUSTOMER_NAMES=""

# Edge router IPs for the fiber walk, comma separated (read by the agent via the path-analyzer skill). Default: none. OPTIONAL.
# EDGE_ROUTER_IPS=""
# LibreQoS CGNAT test subnet (read by the agent via the path-analyzer skill). Default: topology reference. OPTIONAL.
# RDS2216_SUBNET=""
# Path triage mode (read by the agent): direct = live router triage. Default: direct. OPTIONAL.
# PATH_TRIAGE_MODE="direct"
# Tower confidence floor for path analysis (read by the agent). Default: 75. OPTIONAL.
# PATH_TOWER_THRESHOLD="75"
# Bandwidth-test duration in seconds (read by the agent). Default: 10. OPTIONAL.
# BTEST_DURATION="10"
# Bandwidth-test protocol (read by the agent). Default: tcp. OPTIONAL.
# BTEST_PROTOCOL="tcp"
# Bandwidth-test timeout in ms (read by the agent). Default: 60000. OPTIONAL.
# BTEST_TIMEOUT_MS="60000"

# Gated RouterOS writes (poe-cycle, interface enable/disable). Everything defaults to refusing.
# Master kill switch for the routeros-write tool: true to allow. Default: off. OPTIONAL.
# NOC_WRITE_ENABLED="false"
# One-time acknowledgement that the commands were validated on a lab router: must be verified. Default: unset (refuses). OPTIONAL.
# NOC_WRITE_ROUTEROS_TRANSPORT=""
# Exact IPs and/or CIDRs the write tool may touch, comma separated. Default: none (refuses). OPTIONAL.
# NOC_WRITE_ALLOWED_HOSTS=""
# Power-off dwell for poe-cycle in ms (1000..60000). Default: 10000. OPTIONAL.
# NOC_WRITE_POE_CYCLE_PAUSE_MS="10000"
# Port state restored by poe-cycle: forced-on | auto. Default: forced-on. OPTIONAL.
# NOC_WRITE_POE_CYCLE_STRATEGY="forced-on"

# Temporary site connection executor (temp-site-connection skill). Everything defaults to refusing.
# Master kill switch for the temp-* tools: true to allow. Default: off. OPTIONAL.
# TEMP_SITE_WRITE_ENABLED="false"
# Acknowledge the MikroTik transport after validating it: must be verified. Default: unset (refuses). OPTIONAL.
# TEMP_SITE_MT_TRANSPORT=""
# Acknowledge the RouterOS transport after validating it: must be verified. Default: unset (refuses). OPTIONAL.
# TEMP_SITE_ROUTEROS_TRANSPORT=""
# Acknowledge the airOS transport after validating it: must be verified. Default: unset (refuses). OPTIONAL.
# TEMP_SITE_AIROS_TRANSPORT=""
# Exact IPs and/or CIDRs the temp executor may touch, comma separated. Default: none (refuses). OPTIONAL.
# TEMP_SITE_ALLOWED_HOSTS=""
# Fallback WPA keys for temp radio steps: JSON array or one key. Set with env_set.py. Default: none. OPTIONAL.
# TEMP_SITE_WPA_KEYS=""
# Where temp-site snapshots are saved. Default: mcp-server/state/temp-site-snapshots. OPTIONAL.
# TEMP_SITE_SNAPSHOT_DIR=""

# --- Tier 2: Sonar, notifications and the ticket pipeline server ---

# Sonar API bearer token (Sonar > Admin > Security > API Keys). Set with env_set.py. REQUIRED.
SONAR_TOKEN=""
# Sonar base URL. Default: org.sonar_base_url from site-pack/profile.json. OPTIONAL.
# SONAR_BASE_URL="https://example.sonar.software"
# Base URL override used by chat_alert.py only. Default: the profile value. OPTIONAL.
# ORG_SONAR_BASE_URL=""
# Full GraphQL endpoint for schedule_dispatch.mjs. Default: <base url>/api/graphql. OPTIONAL.
# SONAR_GRAPHQL_URL=""
# GraphQL scalar type name for Sonar ids. Default: Int64Bit. OPTIONAL.
# SONAR_ID_SCALAR="Int64Bit"
# Set to 1 to allow a plain http Sonar URL (tests only; https and loopback are always allowed). Default: off. OPTIONAL.
# SONAR_ALLOW_INSECURE_HTTP=""
# Set to 1 to keep newlines in comments posted by sonar_comment.py. Default: off. OPTIONAL.
# SONAR_COMMENT_PRESERVE_NEWLINES=""

# Org-specific Sonar ids. Order everywhere: env var, then site-pack/profile.json
# (sonar.groups / sonar.categories), then a clear error. Fill these only if the profile lacks them.
# NOC group id. Default: from the profile. OPTIONAL.
# NOC_GROUP_ID=""
# Sys Admin group id. Default: from the profile. OPTIONAL.
# SYSADMIN_GROUP_ID=""
# CS Level 2 group id (bounce target). Default: from the profile. OPTIONAL.
# CS_LEVEL2_GROUP_ID=""
# Legacy alias of CS_LEVEL2_GROUP_ID, still read by sonar_bounce.py and metrics_rollup.py. Default: none. OPTIONAL.
# CS_GROUP_ID=""
# Slow Speeds category id. Default: from the profile. OPTIONAL.
# SLOW_SPEEDS_CATEGORY_ID=""
# Night/Peak category id. Default: from the profile. OPTIONAL.
# NIGHT_PEAK_CATEGORY_ID=""
# CX/TH-side Issue category id added on an IHN bounce. Default: from the profile. OPTIONAL.
# IHN_BOUNCE_CATEGORY_ID=""
# Weather category id. Default: from the profile. OPTIONAL.
# WEATHER_CATEGORY_ID=""

# Auto-return governance (the scripts enforce these gates).
# Autonomous bounces to CS Level 2 stay OFF unless this is exactly true. Default: off. OPTIONAL.
# BOUNCE_AUTONOMOUS_ENABLED="false"
# Tower confidence needed for an IHN bounce. Default: 80. OPTIONAL.
# IHN_TOWER_THRESHOLD="80"
# Confidence needed for a correlated downstream bounce. Default: 75. OPTIONAL.
# CORRELATED_CONFIDENCE_THRESHOLD="75"
# Confidence at which a duplicate is handled automatically (read by the agent). Default: 85. OPTIONAL.
# DUPLICATE_HIGH_THRESHOLD="85"
# Confidence at which a duplicate gets an informational comment (read by the agent). Default: 50. OPTIONAL.
# DUPLICATE_MED_THRESHOLD="50"
# Circuit breaker rolling window in seconds. Default: 604800 (7 days). OPTIONAL.
# BREAKER_WINDOW_SEC="604800"
# Runs in the window before the breaker rate is evaluated. Default: 10. OPTIONAL.
# BREAKER_MIN_RUNS="10"
# Failure rate (0-1) that trips the breaker. Default: 0.15. OPTIONAL.
# BREAKER_MAX_ERROR_RATE="0.15"
# Circuit breaker state file. Default: <state dir>/circuit_breaker.json. OPTIONAL.
# BREAKER_STATE_FILE=""
# Decision log directory. Default: <state dir>/decisions. OPTIONAL.
# DECISION_LOG_DIR=""

# Google Chat incoming webhook for the NOC space; without it no chat alert is sent. Set with env_set.py. OPTIONAL.
NOC_TICKETS_GOOGLE_CHAT_WEBHOOK_URL=""
# Set to 0 to skip re-verifying the alert icon URL (offline/dev). Default: verify. OPTIONAL.
# CHAT_ICON_VERIFY=""
# Where alerts go: gchat | slack | discord | teams | ntfy | stdout. Default: gchat (the webhook above, nothing else to set). OPTIONAL.
# NOTIFY_PROVIDER="gchat"
# Webhook URL (ntfy: the topic URL) of the provider chosen above; a secret, set with env_set.py. Default: none (gchat falls back to the Google Chat webhook above). OPTIONAL.
# NOTIFY_WEBHOOK_URL=""
# ntfy access token, sent as a bearer token; a secret, set with env_set.py. Default: none. OPTIONAL.
# NOTIFY_NTFY_TOKEN=""
# Set to 1 to allow a plain http:// notification webhook (for example a ntfy server on your LAN). Default: https only. OPTIONAL.
# NOTIFY_ALLOW_HTTP=""

# Pipeline webhook server (server/index.js).
# Basic-auth token N8N sends as Authorization: Basic base64(OCAGENT:token); at least 24 random characters. Generate: env_set.py --generate TICKET_WEBHOOK_AUTH_TOKEN. REQUIRED.
TICKET_WEBHOOK_AUTH_TOKEN=""
# Separate token for the /governance endpoints (at least 24 characters). Default: governance endpoints disabled. OPTIONAL.
# GOVERNANCE_AUTH_TOKEN=""
# Port for POST /webhook/ticket. Default: 65333. OPTIONAL.
# WEBHOOK_PORT="65333"
# Bind address. Default: 127.0.0.1 (a non-loopback bind needs a TLS proxy in front). OPTIONAL.
# WEBHOOK_BIND="127.0.0.1"
# Set to 1 to say a TLS-terminating proxy sits in front of a non-loopback bind. Default: unset. OPTIONAL.
# WEBHOOK_TLS_PROXY=""
# Largest accepted request body (1kb to 64mb). Default: 256kb. OPTIONAL.
# WEBHOOK_MAX_BODY="256kb"
# Requests allowed per rate window. Default: 120. OPTIONAL.
# WEBHOOK_RATE_LIMIT="120"
# Rate window in ms. Default: 60000. OPTIONAL.
# WEBHOOK_RATE_WINDOW_MS="60000"
# Requests per window for the governance endpoints. Default: 10. OPTIONAL.
# WEBHOOK_GOVERNANCE_RATE_LIMIT="10"
# Most tickets held in the queue before new ones are refused. Default: 500. OPTIONAL.
# WEBHOOK_QUEUE_MAX="500"
# Most tickets batched into one agent run. Default: 3. OPTIONAL.
# MAX_BATCH_SIZE="3"
# Batch collection window in ms. Default: 60000. OPTIONAL.
# WINDOW_DURATION_MS="60000"
# Per-batch agent timeout in ms (batches run one at a time). Default: 2700000 (45 min). OPTIONAL.
# BATCH_TIMEOUT_MS="2700000"
# Grace period in ms between asking the agent to stop and killing it. Default: 30000. OPTIONAL.
# AGENT_KILL_GRACE_MS="30000"
# Grace period in ms for in-flight work on shutdown. Default: 15000. OPTIONAL.
# NOC_SHUTDOWN_GRACE_MS="15000"
# Timeout in ms for the server's outbound HTTP calls. Default: 10000. OPTIONAL.
# NOC_FETCH_TIMEOUT_MS="10000"
# Set to 1 to limit the server's outbound calls to loopback addresses (demo and tests). Default: off. OPTIONAL.
# NOC_FETCH_LOOPBACK_ONLY=""
# Directory for logs. Default: <repo>/logs. OPTIONAL.
# NOC_LOG_DIR=""
# Legacy name of NOC_LOG_DIR. Default: none. OPTIONAL.
# NOC_AGENT_LOG_DIR=""
# Directory for state files (queues, breaker, decisions). Default: the log directory. OPTIONAL.
# NOC_STATE_DIR=""
# Size in bytes at which a log file rotates. Default: 10485760. OPTIONAL.
# NOC_LOG_MAX_BYTES="10485760"
# Rotated log files kept. Default: 5. OPTIONAL.
# NOC_LOG_KEEP="5"
# Where a batch result is saved when it cannot be delivered. Default: the log dir when NOC_LOG_DIR or NOC_STATE_DIR is set, else /tmp. OPTIONAL.
# NOC_RESULT_FALLBACK_DIR=""

# Agent runtime.
# Agent CLI for server runs: opencode | claude | codex | gemini | command. Default: opencode (codex and gemini are experimental). OPTIONAL.
# AGENT_HARNESS="opencode"
# Absolute path of THIS checkout, the agent's working directory. Legacy name OPENCODE_WORKSPACE also works. REQUIRED.
AGENT_WORKSPACE=""
# Legacy name of AGENT_WORKSPACE. Default: none. OPTIONAL.
# OPENCODE_WORKSPACE=""
# Model for server-run agents. Default: opencode/big-pickle (legacy name OPENCODE_MODEL). OPTIONAL.
# AGENT_MODEL=""
# Legacy name of AGENT_MODEL. Default: none. OPTIONAL.
# Permission profile for unattended OpenCode runs: a JSON file with a "permissions" array (default
# deploy/opencode-batch.json: edits only in /tmp and logs/, no secret reads, no git/package/service changes from
# the shell). Applied only to OpenCode 2.x. Set to "off" to run without it (not recommended). OPTIONAL.
# AGENT_PERMISSION_PROFILE=""
# OPENCODE_MODEL=""
# Absolute path of the opencode binary (AGENT_HARNESS=opencode only). Default: found on PATH. OPTIONAL.
# OPENCODE_PATH=""
# Absolute path of the claude binary (AGENT_HARNESS=claude only). Default: claude on PATH. OPTIONAL.
# CLAUDE_PATH=""
# Absolute path of the codex binary (AGENT_HARNESS=codex only). Default: codex on PATH. OPTIONAL.
# CODEX_PATH=""
# Absolute path of the gemini binary (AGENT_HARNESS=gemini only). Default: gemini on PATH. OPTIONAL.
# GEMINI_PATH=""
# Extra CLI arguments for the chosen harness, shell-style quoting, no operators: AGENT_<HARNESS>_ARGS. Default: none. OPTIONAL.
# AGENT_OPENCODE_ARGS=""
# AGENT_CLAUDE_ARGS=""
# AGENT_CODEX_ARGS=""
# AGENT_GEMINI_ARGS=""
# Command line for AGENT_HARNESS=command; needs {prompt} or {prompt_file}, may use {workspace} and {model}; run without a shell. Default: none. OPTIONAL.
# AGENT_COMMAND_TEMPLATE=""
# Set to 1 to run AGENT_COMMAND_TEMPLATE through a shell (prompt arrives only as $NOC_PROMPT). Default: off. OPTIONAL.
# AGENT_COMMAND_SHELL=""
# Extra env names or PREFIX* patterns passed through to the agent process, comma separated. Default: none. OPTIONAL.
# AGENT_ENV_PASSTHROUGH=""

# Peak scheduler (night/peak retest window).
# Set to false to disable the 20:05 peak drain. Default: true. OPTIONAL.
# PEAK_SCHEDULER_ENABLED="true"
# Time zone of the peak window. Default: America/Chicago. OPTIONAL.
# PEAK_WINDOW_TZ="America/Chicago"
# Peak window start, HH:MM. Default: 20:00. OPTIONAL.
# PEAK_WINDOW_START="20:00"
# Peak window end, HH:MM. Default: 21:00. OPTIONAL.
# PEAK_WINDOW_END="21:00"
# Minutes after window start when the drain runs. Default: 5. OPTIONAL.
# PEAK_DRAIN_OFFSET_MIN="5"
# Spacing in ms between queued retests. Default: 600000 (10 min). OPTIONAL.
# PEAK_RETEST_SPACING_MS="600000"
# Attempts per queued ticket before giving up. Default: 3. OPTIONAL.
# PEAK_MAX_ATTEMPTS="3"
# Peak queue file. Default: <state dir>/pending_peak_checks.json. OPTIONAL.
# PEAK_QUEUE_FILE=""

# Metrics, evals and backups (timers from deploy/).
# Directory for eval output. Default: <state dir>/evals. OPTIONAL.
# NOC_EVAL_DIR=""
# Largest accuracy drop in percent the eval gate tolerates. Default: 2. OPTIONAL.
# EVAL_MAX_REGRESSION_PCT="2"
# Set to 1 for eval_run.py --replay (required there, so replay never writes to Sonar). Default: unset. OPTIONAL.
# DRY_RUN=""
# Directory for runtime config backups (created 0700, never inside the repo). Default: ~/nocagent-backups. OPTIONAL.
# BACKUP_DIR=""
# Backups kept. Default: 14. OPTIONAL.
# BACKUP_KEEP="14"
# Passphrase that encrypts the backup tarball. Set with env_set.py. OPTIONAL.
# BACKUP_PASSPHRASE=""
# File holding the backup passphrase (owner-only). Default: none. OPTIONAL.
# BACKUP_PASSPHRASE_FILE=""

# --- Tier 3: Google Calendar and Sheets ---
# One Desktop OAuth client; each secret file lives OUTSIDE the repo (mode 0600, parent 0700) and
# .env stores only the PATH. Mint with the onboarding wizard or
# `node scripts/google_user_auth.mjs authorize --scopes <scopes>`; never paste tokens here.

# OAuth client secret for `google_user_auth.mjs init` (prefer --client-secret-file). Set with env_set.py. OPTIONAL.
# GOOGLE_CLIENT_SECRET=""

# Calendar dispatch (schedule-field-tech skill).
# Auth mode; the only accepted value is user-oauth. Default: user-oauth. OPTIONAL.
# CALENDAR_AUTH_MODE="user-oauth"
# Path of the Calendar OAuth secret file. REQUIRED.
CALENDAR_OAUTH_FILE=""
# true allows creating and deleting calendar events (the CLI also needs --confirm-create). Default: false. OPTIONAL.
# CALENDAR_WRITE_ENABLED="false"
# Calendar used when a direct insert on the tech's calendar is refused. Default: primary. OPTIONAL.
# CALENDAR_FALLBACK_CALENDAR_ID="primary"
# JSON map of tech to calendar id or attendee. Default: site-pack/tech_calendars.json. OPTIONAL.
# CALENDAR_TECH_MAP_FILE=""
# Time zone of dispatch appointments. Default: America/Chicago. OPTIONAL.
# DISPATCH_TIMEZONE="America/Chicago"
# Default appointment start hour (0-23). Default: 8. OPTIONAL.
# DISPATCH_DEFAULT_START_HOUR="8"
# Default appointment length in minutes. Default: 60. OPTIONAL.
# DISPATCH_DEFAULT_DURATION_MINUTES="60"
# Calendar invite mode for the event: all | externalOnly | none. Default: none. OPTIONAL.
# DISPATCH_NOTIFY=""
# true allows flipping the Sonar ticket PENDING_INTERNAL to OPEN on dispatch (the CLI also needs --confirm-sonar). Default: off. OPTIONAL.
# DISPATCH_SONAR_ENABLED="false"
# Dispatch audit log. Default: logs/schedule_dispatch_audit.jsonl. OPTIONAL.
# DISPATCH_AUDIT_FILE=""

# NOC Ticket Tracker sheet (tracker-sheet skill).
# Auth mode; the only accepted value is user-oauth. Default: user-oauth. OPTIONAL.
# TRACKER_AUTH_MODE="user-oauth"
# Path of the Tracker OAuth secret file. REQUIRED.
TRACKER_OAUTH_FILE=""
# Spreadsheet id of the tracker (the long id in the sheet URL). REQUIRED.
TRACKER_SPREADSHEET_ID=""
# Tracker tab name. Default: NOC Ticket Tracker. OPTIONAL.
# TRACKER_TAB="NOC Ticket Tracker"
# Tab holding the pick lists. Default: none. OPTIONAL.
# TRACKER_PICK_TAB=""
# Header row number. Default: 1. OPTIONAL.
# TRACKER_HEADER_ROW="1"
# readonly | write. Default: readonly. OPTIONAL.
# TRACKER_ACCESS="readonly"
# true allows appending rows (needs TRACKER_ACCESS=write and the CLI --confirm-write). Default: false. OPTIONAL.
# TRACKER_WRITE_ENABLED="false"
# Tracker audit log. Default: logs/tracker_sheet_audit.jsonl. OPTIONAL.
# TRACKER_AUDIT_FILE=""

# Temp OSPF sheet (temp-site-connection family).
# Auth mode: service-account | user-oauth. Default: service-account. OPTIONAL.
# TEMP_OSPF_AUTH_MODE="service-account"
# Path of the Temp OSPF OAuth secret file (user-oauth mode). Default: none. OPTIONAL.
# TEMP_OSPF_OAUTH_FILE=""
# Path of the service-account JSON (service-account mode). Default: none. OPTIONAL.
# TEMP_OSPF_CREDENTIALS_FILE=""
# Spreadsheet id of the Temp OSPF sheet. REQUIRED.
TEMP_OSPF_SPREADSHEET_ID=""
# Tab name. Default: Temp OSPF. OPTIONAL.
# TEMP_OSPF_TAB="Temp OSPF"
# Header row number. Default: 1. OPTIONAL.
# TEMP_OSPF_HEADER_ROW="1"
# Rows read from the tab. Default: 40. OPTIONAL.
# TEMP_OSPF_READ_ROWS="40"
# Value that marks a row in use; only true (a checkbox) is accepted. Default: true. OPTIONAL.
# TEMP_OSPF_IN_USE_VALUE=""
# readonly | write. Default: readonly. OPTIONAL.
# TEMP_OSPF_ACCESS="readonly"
# true allows row reservation and release. Default: false. OPTIONAL.
# TEMP_OSPF_WRITE_ENABLED="false"
# Temp OSPF audit log. Default: logs/temp-ospf-sheet.jsonl. OPTIONAL.
# TEMP_OSPF_AUDIT_FILE=""
